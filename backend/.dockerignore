# Keep secrets, local environments, caches and tests out of the image.
# Patterns start with **/ so they match in every folder, not only the top level.
**/.env
**/.env.*
.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
tests/
# The model comparison (issue #14) and its results are not needed at runtime. The Dockerfile
# copies only the demo reset script from scripts/.
scripts/model_comparison/
