# Winlog configuration.
# Copy this file to .env (never committed) and replace the placeholder values.
# The backend reads these variables from the environment, and from this repository's
# .env file when it runs locally. Docker Compose reads the same .env file.

# --- PostgreSQL container (docker-compose.yml) ---
# The test database is created only when the database volume is new. If you already ran
# the database before, run `docker compose down -v` once (this deletes local data).

# Required by Docker Compose. Database user.
POSTGRES_USER=winlog
# Required by Docker Compose. Database password. Use your own value.
POSTGRES_PASSWORD=change-me
# Required by Docker Compose. Name of the development database.
POSTGRES_DB=winlog
# Required by Docker Compose. Name of the test database, used only by integration tests.
POSTGRES_TEST_DB=winlog_test
# Optional, default 5432. Port on your computer where PostgreSQL is published.
POSTGRES_HOST_PORT=5432
# Optional, default 8000. Port on your computer where the backend container is published.
BACKEND_HOST_PORT=8000

# --- Backend ---

# Required. PostgreSQL connection URL for the backend. Treated as a secret, because it
# contains the database password. This value is for running the backend on your computer;
# inside Docker Compose the backend gets its own URL pointing at the db service.
# postgresql:// URLs are accepted and use the psycopg driver.
DATABASE_URL=postgresql+psycopg://winlog:change-me@localhost:5432/winlog

# Required. Comma-separated list of frontend origins allowed to call the API (CORS).
# Write each origin as scheme://host[:port], without a trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional, default 3. Seconds to wait for the database to answer before the health check
# reports it as unreachable. Whole number from 2 to 60.
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Optional, default 7. Days a login lasts: a token stops working this many days after
# login, or earlier when the user logs out. Whole number from 1 to 365.
TOKEN_LIFETIME_DAYS=7

# Required, no default. The AI provider for suggestions and summaries. Allowed values:
# mock (a fake AI with obviously fake output that needs no API key, for local development
# and tests). There is no default, so the app never uses a real or a fake AI by accident.
AI_PROVIDER=mock

# --- Integration tests ---

# Required for integration tests. URL of the test database. Integration tests never fall
# back to DATABASE_URL, so they cannot touch development data.
TEST_DATABASE_URL=postgresql+psycopg://winlog:change-me@localhost:5432/winlog_test
