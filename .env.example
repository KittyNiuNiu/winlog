# Winlog configuration.
# Copy this file to .env (never committed) and replace the placeholder values.
# The backend reads these variables from the environment, and from this repository's
# .env file when it runs locally. Docker Compose reads the same .env file. The frontend
# build reads only the VITE_ variables (see "Frontend" below).

# --- PostgreSQL container (docker-compose.yml) ---
# The test database is created only when the database volume is new. If you already ran
# the database before, run `docker compose down -v` once (this deletes local data).

# Required by Docker Compose. Database user.
POSTGRES_USER=winlog
# Required by Docker Compose. Database password. Use your own value.
POSTGRES_PASSWORD=change-me
# Required by Docker Compose. Name of the development database.
POSTGRES_DB=winlog
# Required by Docker Compose. Name of the test database, used only by integration tests.
POSTGRES_TEST_DB=winlog_test
# Optional, default 5432. Port on your computer where PostgreSQL is published.
POSTGRES_HOST_PORT=5432
# Optional, default 8000. Port on your computer where the backend container is published.
BACKEND_HOST_PORT=8000
# Optional, default 8080. Port on your computer where the frontend container is published:
# with `docker compose up --build` the app is at http://localhost:8080. If you change it,
# change the matching origin in CORS_ALLOWED_ORIGINS below too.
FRONTEND_HOST_PORT=8080

# Optional, default 3000. Port on your computer where the local Grafana (lgtm service) is
# published, on 127.0.0.1 only: http://localhost:3000. It has no login (docs/observability.md).
GRAFANA_HOST_PORT=3000
# Optional, default 4318. Port on your computer where the lgtm service takes OTLP/HTTP
# telemetry, on 127.0.0.1 only. Used by a backend running on your computer (see
# OTEL_EXPORTER_OTLP_ENDPOINT below).
OTLP_HTTP_HOST_PORT=4318

# --- Frontend ---

# Required for the frontend build. Base URL of the backend API that the browser calls,
# written as scheme://host[:port] without a trailing slash. Vite reads it from this file
# when you run `npm run dev`, `npm run build` or `npm test` in frontend/, and Docker Compose
# passes it to the frontend image build as a build argument. It is built into the
# JavaScript files, so it is public: never put a secret into a VITE_ variable. The default
# is the backend's local address; if you change BACKEND_HOST_PORT, change the port here too.
VITE_API_BASE_URL=http://localhost:8000

# --- Backend ---

# Optional, default 8000. Port the backend server listens on inside its container. Render sets
# it (production). It is read only by the backend's start script (backend/start.sh), from the
# process environment, never from this file; Docker Compose does not set it, so the container
# listens on 8000 there. To publish the backend on another port on your computer, change
# BACKEND_HOST_PORT above instead.
PORT=

# Required. PostgreSQL connection URL for the backend. Treated as a secret, because it
# contains the database password. This value is for running the backend on your computer;
# inside Docker Compose the backend gets its own URL pointing at the db service.
# postgresql:// URLs are accepted and use the psycopg driver.
DATABASE_URL=postgresql+psycopg://winlog:change-me@localhost:5432/winlog

# Required. Comma-separated list of frontend origins allowed to call the API (CORS).
# Write each origin as scheme://host[:port], without a trailing slash.
# The defaults are the frontend's local addresses: the Vite dev server (`npm run dev` in
# frontend/, port 5173) and the frontend container (FRONTEND_HOST_PORT, port 8080).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional, default 3. Seconds to wait for the database to answer before the health check
# reports it as unreachable. Whole number from 2 to 60.
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Optional, default 7. Days a login lasts: a token stops working this many days after
# login, or earlier when the user logs out. Whole number from 1 to 365.
TOKEN_LIFETIME_DAYS=7

# Required, no default. The AI provider for suggestions and summaries. Allowed values:
# - mock: a fake AI with obviously fake output that needs no API key, for local development
#   and tests.
# - openai-compatible: a real LLM through an OpenAI-compatible chat API (OpenRouter is
#   planned). Needs AI_BASE_URL, AI_API_KEY and AI_MODEL below.
# There is no default, so the app never uses a real or a fake AI by accident.
AI_PROVIDER=mock

# Required when AI_PROVIDER is openai-compatible, ignored otherwise. Base URL of the
# OpenAI-compatible API. Every request asks OpenRouter to use only zero-data-retention
# endpoints.
AI_BASE_URL=https://openrouter.ai/api/v1

# Required when AI_PROVIDER is openai-compatible, ignored otherwise. API key for the AI
# provider. Treated as a secret: never commit a real key, put it only in your .env file.
AI_API_KEY=

# Required when AI_PROVIDER is openai-compatible, ignored otherwise. The model the provider
# calls, as an OpenRouter model id (vendor/model-name). The default was chosen by a documented
# comparison: see docs/decisions/default-model.md.
AI_MODEL=anthropic/claude-haiku-5.5

# Optional, default 15. Seconds to wait for the AI provider to answer a suggestion request.
# Whole number from 1 to 600.
AI_SUGGESTION_TIMEOUT_SECONDS=15

# Optional, default 60. Seconds to wait for the AI provider to answer a summary request.
# Whole number from 1 to 600.
AI_SUMMARY_TIMEOUT_SECONDS=60

# Optional, default 16000. The most tokens the model may write for one summary (sent as
# max_tokens; used only by the openai-compatible provider). A summary has at most 10,000
# characters. That is about 2,500 tokens in English, about 3,300 in German and up to about
# 10,000 in Chinese, Japanese or Korean, and reasoning models add their reasoning tokens.
# A value below that can cut off valid summaries, which then fail with "AI unavailable".
# A higher value only raises the most one summary can cost. Whole number from 1 to 100000.
AI_SUMMARY_MAX_TOKENS=16000

# Optional, default 50000. The most characters the entries matching a summary's filter may
# have together: each entry's text, Result/Impact and tag names, added up. Above it, no
# summary is generated (no AI call, nothing counted) and the user is asked to narrow the
# filter. It bounds how much one summary request sends to the AI provider. Whole number of 1
# or more; anything else stops the backend at startup.
AI_SUMMARY_MAX_INPUT_CHARACTERS=50000

# Daily AI usage limits. A day runs from 00:00 to 24:00 UTC, and all counts start again at
# 00:00 UTC. Every AI call that is attempted counts, including calls that fail or time out.
# Each value is a whole number of 0 or more; 0 blocks that kind of request. Anything else
# stops the backend at startup. The demo account is limited like any other user.

# Optional, default 10. AI suggestions (category and tags) one user can request per day.
AI_DAILY_SUGGESTIONS_PER_USER=10

# Optional, default 2. AI summaries one user can generate per day.
AI_DAILY_SUMMARIES_PER_USER=2

# Optional, default 100. AI requests per day across all users, suggestions and summaries
# together (the global cap). Deleting an account does not lower this count.
AI_DAILY_REQUESTS_GLOBAL=100

# --- Login and demo-login attempt limits (FR-A4) ---
# A request over a limit is refused with "too many attempts" and a Retry-After header until
# its window ends. The counts are stored in the database (as SHA-256 hashes of the email or
# IP, never in plain text), so they survive restarts. Each value is a whole number of 1 or
# more (each window at most 525600, one year); anything else stops the backend at startup.

# Optional, default 10. Failed logins for one email within the window below. After that
# many, every login for that email is refused, even with the correct password, until the
# window ends: that many minutes after the first failure. Unknown emails count the same
# way, and wrong passwords on account deletion count too. A successful login clears the count.
LOGIN_MAX_FAILED_ATTEMPTS=10

# Optional, default 15. Minutes of the failed-login window.
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Optional, default 20. Demo-logins from one visitor IP address within the window below.
# The IP is the last X-Forwarded-For entry, added by the hosting proxy (Render), or the
# address of the direct connection when that header is missing.
DEMO_LOGIN_MAX_ATTEMPTS=20

# Optional, default 60. Minutes of the demo-login window.
DEMO_LOGIN_WINDOW_MINUTES=60

# --- Demo account (FR-X1) ---

# Optional, default empty. Email of the shared demo account, for example demo@example.com.
# Empty or not set turns the demo off: demo-login then returns "not found". The seed script
# (`uv run python -m scripts.seed_demo` in backend/) creates this user with a random password
# that is never shown, and resets its entries, tags and summaries to the sample data.
# Use an address nobody can register for themselves before the script runs, because the
# script treats the existing user with this email as the demo account and replaces its data.
# The demo account cannot be deleted, and its daily AI limits are shared by all visitors.
DEMO_EMAIL=

# --- Telemetry (docs/observability.md) ---

# Optional, default empty. Base URL of an OpenTelemetry collector that takes OTLP/HTTP, without
# a path; the backend adds /v1/traces, /v1/metrics and /v1/logs. Empty or not set exports
# nothing and never connects anywhere; the JSON logs on stdout still carry trace and span IDs.
# To run the backend on your computer against the local stack (`docker compose up -d lgtm`),
# set it to http://localhost:4318 (the port is OTLP_HTTP_HOST_PORT). Inside Docker Compose the
# backend gets http://lgtm:4318. Must start with http:// or https://. The tests never use it.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Integration tests ---

# Required for integration tests. URL of the test database. Integration tests never fall
# back to DATABASE_URL, so they cannot touch development data.
TEST_DATABASE_URL=postgresql+psycopg://winlog:change-me@localhost:5432/winlog_test
